# ===== Larkhré se présente : le physicien =====
fonk presente(phrase, voix) {
    vox(phrase)
    dis(voix)
}
fonk presente_couleur(phrase, voix, couleur) {
    vox_couleur(phrase, couleur)
    dis(voix)
}

presente("Tu entends ? C'est un programme qui te parle.", "Tu entends ? C'est un programme qui te parle.")
presente("Et je vais te montrer de la physique quantique.", "Et je vais te montrer de la physique quantique.")
qubits(2)
superpose(0)
intrique(0, 1)
presente("Deux qubits liés, dans mon simulateur quantique :", "Deux qubits liés, dans mon simulateur quantique.")
voir()
presente("Je fais l'expérience mille fois :", "Je fais l'expérience mille fois.")
voir(mesure_repetee(1000))
presente("01 et 10 ne sortent jamais : c'est l'intrication.", "Zéro-un et un-zéro ne sortent jamais. C'est l'intrication.")
presente_couleur("Je m'appelle Larkhré : mosi larkhré, la langue de la machine en soninké.", "Je m'appelle Larkré. Mossi raanné, la langue de la machine en soni-nnékéé.", "or")
presente("Un langage en français, avec des erreurs expliquées. Rien à installer, et gratuit.", "Un langage en français, avec des erreurs expliquées. Rien à installer, et gratuit.")
presente("Essaie sur ton téléphone :", "Essaie sur ton téléphone :")
presente_couleur("larkhre.github.io", "larkré point guitt-hub point i-o.", "vert")
