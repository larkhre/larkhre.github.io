# ===== Larkhré se présente : l'autoportrait =====
fonk presente(phrase, voix) {
    vox(phrase)
    dis(voix)
}

presente("Tu entends ? C'est un programme qui te parle.", "Tu entends ? C'est un programme qui te parle.")
attends(0.5)
vox_couleur("Je m'appelle Larkhré.", "or")
dis("Je m'appelle Larkré.")
presente("Mon nom vient du soninké : mosi larkhré, la langue de la machine.", "Mon nom vient du soni-nnékéé. Mossi raanné : la langue de la machine.")
presente("Je suis un langage de programmation en français.", "Je suis un langage de programmation en français.")
presente("Je sais calculer :", "Je sais calculer.")
laz resultat = 7 * 8
vox_couleur("7 × 8 = {resultat}", "cyan")
dis("Sept fois huit : {resultat}.")
presente("Regarde, je me trompe exprès :", "Regarde, je me trompe exprès.")
laz nom = "Awa"
essaie {
    vox(nmo)
} rattrape erreur {
    vox_couleur(erreur, "rouge")
}
dis("Tu vois ? Même mes erreurs sont expliquées en français.")
presente("Rien à installer. Je fonctionne sur ton téléphone. Et je suis gratuit.", "Rien à installer. Je fonctionne sur ton téléphone. Et je suis gratuit.")
vox_couleur("larkhre.github.io", "vert")
dis("Viens me parler : larkré point guitt-hub point i-o.")
