# ===== Larkhré se présente : le dessinateur =====
# Comment la voix prononce les mots difficiles : change ici, et c'est corrigé partout
laz dit_larkhre = "Larkré"
laz dit_soninke = "soniinnké"
laz dit_mossi = "mossi sef ra-né"
laz dit_adresse = "larkré point guitt-hub point i-o"

# La voix : « Français France », à peine plus lente que la normale, hauteur naturelle.
# Si l'appareil n'a pas de voix « France », on garde sa voix par défaut, avec le même ton.
essaie {
    regle_voix("France", 0.9, 1)
} rattrape erreur {
    regle_voix("", 0.9, 1)
}

fonk presente(phrase, voix) {
    vox(phrase)
    dis(voix)
}
fonk presente_couleur(phrase, voix, couleur) {
    vox_couleur(phrase, couleur)
    dis(voix)
}

presente("Tu entends ? C'est un programme qui te parle.", "Tu entends ? C'est un programme qui te parle.")
presente("Et en parlant, je dessine.", "Et en parlant, je dessine.")
toile(300, 220)
fond("bleu")
rect_plein(0, 170, 300, 50, "jaune")
pou i dan 1..6 {
    cercle_plein(240, 60, i * 5, "or")
    attends(0.1)
}
presente("Un soleil.", "Un soleil.")
rect_plein(135, 110, 30, 60, "gris")
pou i dan 1..5 {
    cercle_plein(90 + i * 20, 100, 28, "vert")
    attends(0.1)
}
presente("Et un arbre, pour se retrouver dessous.", "Et un arbre, pour se retrouver dessous.")
presente("Chaque forme, c'est une ligne de code que tu peux écrire toi aussi.", "Chaque forme, c'est une ligne de code que tu peux écrire toi aussi.")
presente_couleur("Je m'appelle Larkhré.", "Je m'appelle {dit_larkhre}.", "or")
presente("Mossi sef raanné : la langue de la machine, en soninké.", "{dit_mossi} : la langue de la machine, en {dit_soninke}.")
presente("Un langage de programmation en français, avec des erreurs expliquées.", "Un langage de programmation en français, avec des erreurs expliquées.")
presente("Rien à installer, sur ton téléphone, et tout est gratuit.", "Rien à installer, sur ton téléphone, et tout est gratuit.")
presente("Viens dessiner avec moi :", "Viens dessiner avec moi :")
presente_couleur("larkhre.github.io", "{dit_adresse}.", "vert")
