# ===== Larkhré se présente : le physicien =====
# Comment la voix prononce les mots difficiles : change ici, et c'est corrigé partout
laz dit_larkhre = "Larkré"
laz dit_soninke = "soniinnké"
laz dit_mossi = "mossi sef ra-né"
laz dit_adresse = "larkré point guitt-hub point i-o"

fonk presente(phrase, voix) {
    vox(phrase)
    dis(voix)
}
fonk presente_couleur(phrase, voix, couleur) {
    vox_couleur(phrase, couleur)
    dis(voix)
}

presente("Tu entends ? C'est un programme qui te parle.", "Tu entends ? C'est un programme qui te parle.")
presente("Et je vais te montrer de la physique quantique.", "Et je vais te montrer de la physique quantique.")
qubits(2)
superpose(0)
intrique(0, 1)
presente("Deux qubits liés, dans mon simulateur quantique :", "Deux qubits liés, dans mon simulateur quantique.")
voir()
dis("Zéro-zéro : cinquante pour cent. Un-un : cinquante pour cent.")
presente("Je fais l'expérience mille fois :", "Je fais l'expérience mille fois.")
laz resultats = mesure_repetee(1000)
voir(resultats)
laz fois_00 = resultats["00"]
laz fois_11 = resultats["11"]
dis("Zéro-zéro : {fois_00} fois. Un-un : {fois_11} fois.")
presente("01 et 10 ne sortent jamais : c'est l'intrication.", "Zéro-un et un-zéro ne sortent jamais. C'est l'intrication.")
presente_couleur("Je m'appelle Larkhré : mossi sef raanné, la langue de la machine en soninké.", "Je m'appelle {dit_larkhre}. {dit_mossi}, la langue de la machine en {dit_soninke}.", "or")
presente("Un langage en français, avec des erreurs expliquées.", "Un langage en français, avec des erreurs expliquées.")
presente("Rien à installer, sur ton téléphone, et tout est gratuit.", "Rien à installer, sur ton téléphone, et tout est gratuit.")
presente("Viens m'essayer :", "Viens m'essayer :")
presente_couleur("larkhre.github.io", "{dit_adresse}.", "vert")
