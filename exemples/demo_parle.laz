# ===== v8.0 : Larkhré PARLE ! =====
# Monte le son 🔊 — ton programme va parler en français.

dis("Bonjour ! Je suis Larkhré, le langage qui parle.")
vox("🗣️ Écoute...")

laz prenom = demand("Comment tu t'appelles ? ")
dis("Enchanté " + prenom + " ! Tu vas apprendre à coder.")
vox_couleur("Bienvenue {prenom} !", "or")

pou i dan 1..3 {
    vox("Décompte :", i)
}
dis("3, 2, 1... c'est parti !")
